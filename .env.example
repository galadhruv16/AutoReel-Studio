# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Stitch API Key (Optional, for Stitch MCP designs)
STITCH_API_KEY=your_stitch_api_key_here

# Admin Authentication (Insider Protection)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here
AUTH_SECRET=your_random_32_byte_secret_hex

# Supabase Persistence (Optional, falls back to local persistent JSON file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Meta Graph API (Optional, for direct Instagram Reels publishing & scheduling)
INSTAGRAM_ACCESS_TOKEN=your_meta_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

